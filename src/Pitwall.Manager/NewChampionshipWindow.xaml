<Window x:Class="Pitwall.Manager.NewChampionshipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Pitwall.Manager"
        Title="Nuovo campionato" Height="720" Width="980"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}">

    <DockPanel Margin="16">

        <!-- I passi, in alto: si vede dove si e e quanto manca. -->
        <TextBlock DockPanel.Dock="Top" x:Name="StepTitle" Style="{StaticResource Heading}"
                   FontSize="20" Margin="0,0,0,2" />
        <TextBlock DockPanel.Dock="Top" x:Name="StepNote" Style="{StaticResource Note}"
                   Margin="0,0,0,12" TextWrapping="Wrap" />

        <!-- I pulsanti, in basso. -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <TextBlock x:Name="Summary" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Content="{l:T cfg.indietro}" Click="OnBack" Width="110" />
                <Button x:Name="NextButton" Content="{l:T cfg.avanti}" Click="OnNext" Width="110" Margin="8,0,0,0" />
                <Button Content="{l:T cfg.annulla}" Click="OnCancel" Width="110" Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>

        <TabControl x:Name="Steps" BorderThickness="0" Background="Transparent">

            <!-- ============================ 1. Il campionato ============================ -->
            <TabItem Header="{l:T cfg.1.campionato}">
                <StackPanel Margin="4,12,4,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="420" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="{l:T cfg.nome}" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="FieldName" Margin="0,3" />

                        <Label Grid.Row="1" Grid.Column="0" Content="{l:T cfg.stagione}" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="FieldYear" Margin="0,3" />

                        <Label Grid.Row="2" Grid.Column="0" Content="{l:T cfg.descrizione}" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="FieldDescription" Margin="0,3"
                                 Height="70" AcceptsReturn="True" TextWrapping="Wrap" />
                    </Grid>

                    <TextBlock Text="{l:T cfg.calendario}" Style="{StaticResource Heading}" Margin="0,22,0,6" />
                    <CheckBox x:Name="FieldCalendar" IsChecked="True"
                              Content="{l:T cfg.genera.il.calendario.completo.con.i}" />
                    <TextBlock Style="{StaticResource Note}" Margin="22,2,0,0" TextWrapping="Wrap"
                               Text="{l:T cfg.senza.la.spunta.il.campionato.nasce}" />
                </StackPanel>
            </TabItem>

            <!-- ============================== 2. La griglia ============================== -->
            <TabItem Header="{l:T cfg.2.griglia}">
                <DockPanel Margin="4,12,4,4">
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="{l:T cfg.quante.vetture}" Width="150" />
                            <ComboBox x:Name="FieldGridSize" Width="140"
                                      SelectionChanged="OnGridSizeChanged" />
                            <TextBlock x:Name="GridCount" VerticalAlignment="Center" Margin="16,0,0,0"
                                       Foreground="{StaticResource Muted}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Note}" Margin="150,4,0,10" TextWrapping="Wrap"
                                   Text="{l:T cfg.due.piloti.per.scuderia.come.in}" />
                    </StackPanel>

                    <DataGrid x:Name="TeamGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="{l:T cfg.in.gara}" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                            <DataGridTextColumn Header="{l:T cfg.scuderia}" Binding="{Binding Name}" Width="200" />
                            <DataGridTextColumn Header="{l:T cfg.sigla}" Binding="{Binding ShortName}" Width="70" />
                            <DataGridTextColumn Header="{l:T cfg.motore}" Binding="{Binding PowerUnit}" Width="140" />
                            <DataGridTextColumn Header="{l:T cfg.piloti}" Binding="{Binding DriverNames}" Width="*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- =============================== 3. I piloti =============================== -->
            <TabItem Header="{l:T cfg.3.piloti}">
                <DockPanel Margin="4,12,4,4">
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="{l:T cfg.al.volante.ci.sei.tu}" Width="150" />
                            <ComboBox x:Name="FieldSeat" Width="320" DisplayMemberPath="Label"
                                      SelectionChanged="OnSeatChanged" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Note}" Margin="150,4,0,10" TextWrapping="Wrap"
                                   Text="{l:T cfg.prendi.il.posto.di.questo.pilota}" />
                    </StackPanel>

                    <DataGrid x:Name="DriverGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:T cfg.n}" Binding="{Binding Number}" Width="45" />
                            <DataGridTextColumn Header="{l:T cfg.nome}" Binding="{Binding FirstName}" Width="130" />
                            <DataGridTextColumn Header="{l:T cfg.cognome}" Binding="{Binding LastName}" Width="150" />
                            <DataGridTextColumn Header="{l:T cfg.sigla}" Binding="{Binding Abbreviation}" Width="60" />
                            <DataGridTextColumn Header="{l:T cfg.scuderia}" Binding="{Binding TeamName}" Width="160" IsReadOnly="True" />
                            <DataGridTextColumn Header="{l:T cfg.abilita.ia}" Binding="{Binding AiSkill}" Width="80" />
                            <DataGridTextColumn Header="{l:T cfg.aggressivita}" Binding="{Binding AiAggression}" Width="95" />
                            <DataGridTextColumn Header="{l:T cfg.nazione}" Binding="{Binding Nationality}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================== 4. Il calendario ============================== -->
            <TabItem Header="{l:T cfg.4.calendario}">
                <DockPanel Margin="4,12,4,4">
                    <StackPanel DockPanel.Dock="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="{l:T cfg.prove.libere}" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                <ComboBox x:Name="FieldPracticeCount" Width="150" SelectionChanged="OnCalendarChanged" />
                                <TextBlock Text="{l:T cfg.da}" VerticalAlignment="Center" Margin="10,0" />
                                <TextBox x:Name="FieldPracticeMinutes" Width="50" Text="60" />
                                <TextBlock Text="{l:T cfg.minuti}" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>

                            <Label Grid.Row="1" Grid.Column="0" Content="{l:T cfg.qualifica}" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="FieldQualiMinutes" Width="50" Text="45" />
                                <TextBlock Text="{l:T cfg.minuti}" VerticalAlignment="Center" Margin="10,0,16,0" />
                                <CheckBox x:Name="FieldKnockout" IsChecked="True" VerticalAlignment="Center"
                                          Content="{l:T cfg.a.eliminazione.q1.q2.q3}" />
                            </StackPanel>

                            <Label Grid.Row="2" Grid.Column="0" Content="{l:T cfg.lunghezza.gara}" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <ComboBox x:Name="FieldRaceDistance" Width="150" SelectionChanged="OnCalendarChanged" />
                                <TextBlock Text="{l:T cfg.della.distanza.vera}" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource Note}" Margin="150,8,0,4" TextWrapping="Wrap"
                                   Text="{l:T cfg.nei.fine.settimana.con.la.sprint}" />

                        <StackPanel Orientation="Horizontal" Margin="150,6,0,10">
                            <Button Content="{l:T cfg.tutte.le.gare}" Click="OnAllRounds" Width="120" />
                            <Button Content="{l:T cfg.nessuna}" Click="OnNoRounds" Width="100" Margin="8,0,0,0" />
                            <TextBlock x:Name="RoundCount" VerticalAlignment="Center" Margin="16,0,0,0"
                                       Foreground="{StaticResource Muted}" />
                        </StackPanel>
                    </StackPanel>

                    <DataGrid x:Name="RoundGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="{l:T cfg.in.calendario}" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                            <DataGridTextColumn Header="{l:T cfg.gran.premio}" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="{l:T cfg.paese}" Binding="{Binding Country}" Width="150" IsReadOnly="True" />
                            <DataGridCheckBoxColumn Header="{l:T cfg.sprint}" Binding="{Binding Sprint, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                            <DataGridTextColumn Header="{l:T cfg.giri}" Binding="{Binding LapsText}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ================================ 4. I punti ================================ -->
            <TabItem Header="{l:T cfg.5.punti}">
                <StackPanel Margin="4,12,4,4">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="{l:T cfg.sistema.punti}" Width="150" />
                        <ComboBox x:Name="FieldPoints" Width="280" SelectionChanged="OnPointsChanged" />
                    </StackPanel>

                    <TextBlock x:Name="PointsPreview" Margin="150,8,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource Muted}" />

                    <TextBlock Text="{l:T cfg.bonus}" Style="{StaticResource Heading}" Margin="0,22,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Label Content="{l:T cfg.giro.veloce}" Width="150" />
                        <TextBox x:Name="FieldFastestLap" Width="60" Text="0" />
                        <TextBlock Text="{l:T cfg.punti.solo.se.arrivi.entro.il}" VerticalAlignment="Center" Margin="10,0" />
                        <TextBox x:Name="FieldFastestLapMax" Width="45" Text="10" />
                        <TextBlock Text="{l:T cfg.posto}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Label Content="{l:T cfg.pole.position}" Width="150" />
                        <TextBox x:Name="FieldPole" Width="60" Text="0" />
                        <TextBlock Text="{l:T cfg.punti}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="{l:T cfg.riepilogo}" Style="{StaticResource Heading}" Margin="0,22,0,6" />
                    <Border Background="{StaticResource Panel}" Padding="14" CornerRadius="2">
                        <TextBlock x:Name="FinalSummary" TextWrapping="Wrap" LineHeight="22" />
                    </Border>
                </StackPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
