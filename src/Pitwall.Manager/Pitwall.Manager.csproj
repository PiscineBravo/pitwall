    <UseWPF>true</UseWPF>
    <RootNamespace>Pitwall.Manager</RootNamespace>
    <AssemblyName>Pitwall.Manager</AssemblyName>
    <ApplicationTitle>Pitwall Manager</ApplicationTitle>
    <LangVersion>12.0</LangVersion>
